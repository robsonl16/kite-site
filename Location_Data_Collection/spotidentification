import os
import requests
import json
import pandas as pd
import time
import numpy as np

# Define the directory and filename for saving the cumulative data
save_directory = "C:/weather_station_data"  # Update to your desired path
os.makedirs(save_directory, exist_ok=True)  # Create directory if it doesn't exist
cumulative_filename = os.path.join(save_directory, "all_weather_stations_241117_z20.csv")

# Initialize cumulative station count
total_stations = 0

# Define the API endpoint
url = "https://api.weatherflow.com/wxengine/rest/spot/getSpotDetailSetByZoomLevel"

# WeatherFlow API token
wf_token = "c6978316c4a132b29e5ec20850ecf0c8"

# Minimum longitude width for shrinking (e.g., 0.1 degrees)
MIN_LONGITUDE_SLIVER = 0.1

# Function to fetch and append data for a specific latitude range with adaptive longitude slivers
def fetch_with_longitude_slivers(lat_min, lat_max, lon_min, lon_max, zoom=20):
    global total_stations

    # If longitude range is smaller than minimum sliver width, stop further shrinking
    if (lon_max - lon_min) <= MIN_LONGITUDE_SLIVER:
        print(f"Reached minimum longitude sliver size at {lat_min} to {lat_max}, {lon_min} to {lon_max}")
        return

    # Set parameters for API request
    params = {
        "units_wind": "mph",
        "units_temp": "f",
        "units_distance": "mi",
        "units_precip": "mm",
        "sort": "distance",
        "spot_types": "1,100",
        "stormprint_only": "false",
        "include_nowcast_obs": "false",
        "lat_min": str(lat_min),
        "lat_max": str(lat_max),
        "lon_min": str(lon_min),
        "lon_max": str(lon_max),
        "zoom": str(zoom),
        "wf_token": wf_token
    }
    
    # Make the GET request to the API
    response = requests.get(url, params=params)
    
    if response.status_code == 200:
        # Check if the response is too large
        if len(response.content) > 5 * 1024 * 1024:  # 5 MB threshold
            print(f"Warning: Response size too large for segment {lat_min} to {lat_max}, {lon_min} to {lon_max}, shrinking longitude range.")
            # Split the longitude range into two smaller "slivers"
            mid_lon = (lon_min + lon_max) / 2
            fetch_with_longitude_slivers(lat_min, lat_max, lon_min, mid_lon, zoom)
            fetch_with_longitude_slivers(lat_min, lat_max, mid_lon, lon_max, zoom)
            return

        # Parse JSON response content with backslash handling
        try:
            content = response.text
            if content.startswith("jQuery"):
                start_idx = content.find("(") + 1
                end_idx = content.rfind(")")
                content = content[start_idx:end_idx]
            
            # Escape unescaped backslashes
            content = content.replace('\\', '\\\\')
            
            data = json.loads(content)
        except json.JSONDecodeError as e:
            print(f"JSON decoding error at segment {lat_min} to {lat_max}, {lon_min} to {lon_max}: {e}")
            # Split longitude slivers further if JSON parsing fails
            mid_lon = (lon_min + lon_max) / 2
            fetch_with_longitude_slivers(lat_min, lat_max, lon_min, mid_lon, zoom)
            fetch_with_longitude_slivers(lat_min, lat_max, mid_lon, lon_max, zoom)
            return

        stations = data.get("spots", [])
        
        # Prepare data for saving
        station_data = []
        for station in stations:
            station_data.append({
                "Spot ID": station.get("spot_id"),
                "Name": station.get("name"),
                "Station Code": station.get("station_code"),
                "Latitude": station.get("lat"),
                "Longitude": station.get("lon"),
                "City": station.get("city"),
                "State": station.get("state"),
                "Country": station.get("country"),
                "County": station.get("county"),
                "Time Zone Name": station.get("tz_name"),
                "Time Zone Name Short": station.get("tz_name_short"),
                "Time Zone Offset": station.get("tz_offset"),
                "Structure Type": station.get("structure_type"),
                "Mesonet Name": station.get("mesonet_name"),
                "Ground Elevation": station.get("ground_elevation"),
                "Install Date UTC": station["stations"][0].get("install_date_utc") if station.get("stations") else None,
                "Station Elevation": station["stations"][0].get("station_elevation") if station.get("stations") else None
            })
        
        # Append data to cumulative CSV file
        df = pd.DataFrame(station_data)
        df.to_csv(cumulative_filename, mode='a', header=not os.path.exists(cumulative_filename), index=False)

        # Update running totals
        num_stations = len(station_data)
        total_stations += num_stations
        print(f"Segment {lat_min} to {lat_max}, {lon_min} to {lon_max} found {num_stations} stations. Total so far: {total_stations}")
    else:
        print(f"Failed to retrieve data for segment {lat_min} to {lat_max}, {lon_min} to {lon_max}")


# Loop through the world in latitude bands with adaptive longitude slivers
def collect_world_data():
    # Latitude ranges from -90 to 90, Longitude ranges from -180 to 180
    for lat in np.arange(-90, 89.9, 0.2):
        lat_min, lat_max = lat, lat + 0.2
        print(f"Processing latitude band {lat_min} to {lat_max}")
        # Process each latitude band, allowing longitude slivers to shrink as needed
        fetch_with_longitude_slivers(lat_min, lat_max, -180, 179.9999)

        # Pause briefly to respect rate limits and avoid overloading the server
        time.sleep(0.01)

# Run the data collection
collect_world_data()
